# Password untuk masuk ke halaman admin (/admin)
# Ganti dengan password kamu sendiri, lalu salin file ini ke .env
ADMIN_PASSWORD=admin123

# Database Neon/Postgres dari Vercel Storage
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Token Vercel Blob untuk upload gambar permanen di production
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
